{
  "name": "informationperisai-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "build:worker": "prisma generate && open-next build",
    "deploy": "npm run build:worker && wrangler deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
