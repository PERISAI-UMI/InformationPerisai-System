    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/sanitize-html": "^2.16.2",
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.8",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.150.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
