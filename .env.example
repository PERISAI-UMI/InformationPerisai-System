# ========================================================
# UKM PERISAI UMI — Application Environment Variables Template
# ========================================================
# Salin berkas ini ke '.env' lalu sesuaikan dengan nilai lingkungan Anda:
# cp .env.example .env
#
# PANDUAN KEAMANAN:
# - Berkas .env tidak boleh di-commit ke Git repo (sudah terdaftar di .gitignore).
# - Untuk deployment Cloudflare Workers, gunakan 'bash scripts/setup-secrets.sh'
#   atau 'npx wrangler secret put <NAME>' untuk mendaftarkan secret terenkripsi.
# ========================================================

# --------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION (CORE)
# --------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rahasia enkripsi sesi login (Ganti dengan string acak entropi tinggi minimal 32 karakter)
# Contoh generate: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-kunci-acak-rahasia-minimal-32-karakter

# --------------------------------------------------------
# 2. BASIS DATA (TURSO LIBSQL CLOUD ATAU SQLITE LOKAL)
# --------------------------------------------------------

# Opsi A: Turso Cloud LibSQL (Wajib untuk Cloudflare Workers Production)
# Rekomendasi Region: Tokyo (aws-ap-northeast-1) untuk latensi optimal dari Indonesia
TURSO_DATABASE_URL=libsql://perisai-psdm-org.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token-here

# Opsi B: SQLite Lokal (Direkomendasikan untuk Development Offline)
DATABASE_URL=file:./psdm-db.db

# --------------------------------------------------------
# 3. PENYIMPANAN MEDIA (OBJECT STORAGE DRIVER)
# --------------------------------------------------------
# Pilihan driver: 'r2' atau 's3' (Cloud) | 'local' (Penyimpanan disk lokal)
STORAGE_DRIVER=r2

# Konfigurasi Cloudflare R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=perisai-media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://media.perisai-umi.org
R2_REGION=auto

# Alias S3 standar (opsional jika menggunakan SDK S3 generik)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=perisai-media
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_PUBLIC_URL=https://media.perisai-umi.org
# S3_REGION=auto

# --------------------------------------------------------
# 4. CLOUDFLARE INTEGRATION (TURNSTILE & CACHE PURGE)
# --------------------------------------------------------
# Cloudflare Turnstile (Anti-Bot / Captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Cloudflare Cache Purge API (Otomatisasi invalidasi cache CDN)
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --------------------------------------------------------
# 5. RUNTIME FLAGS (OPSIONAL)
# --------------------------------------------------------
# Paksa penggunaan pipeline Node.js untuk optimasi gambar (default: false di edge)
FORCE_NODE_IMAGES=false
