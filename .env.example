# ========================================================
# UKM PERISAI UMI — Application Environment Variables Template
# ========================================================
# Salin berkas ini ke '.env' lalu sesuaikan dengan nilai lingkungan Anda:
# cp .env.example .env

# --------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION
# --------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=ganti-dengan-kunci-acak-rahasia-minimal-32-karakter

# --------------------------------------------------------
# 2. BASIS DATA (PILIH SALAH SATU: TURSO ATAU SQLITE LOKAL)
# --------------------------------------------------------

# Opsi A: Turso Cloud LibSQL (Direkomendasikan untuk Cloudflare / Edge Deployment)
TURSO_DATABASE_URL=libsql://<NAMA_DATABASE>-<ORGANISASI>.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token-here

# Opsi B: SQLite Lokal (Direkomendasikan untuk Development Offline / VPS)
# DATABASE_URL=file:./psdm-db.db

# --------------------------------------------------------
# 3. PENYIMPANAN MEDIA (STORAGE DRIVER)
# --------------------------------------------------------
# Pilihan driver: 'r2' atau 's3' (Cloud) | 'local' (Penyimpanan disk lokal)
STORAGE_DRIVER=r2

# Konfigurasi Cloudflare R2 / AWS S3
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=perisai-media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://media.perisai-umi.org
R2_REGION=auto

# Alias S3 standar (opsional jika memilih menggunakan prefix S3_*)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=perisai-media
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_PUBLIC_URL=https://media.perisai-umi.org

# --------------------------------------------------------
# 4. CLOUDFLARE INTEGRATION (CACHE & TURNSTILE - OPSIONAL)
# --------------------------------------------------------
# Cloudflare Turnstile (Anti-Bot / Captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Cloudflare Cache Purge API
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
