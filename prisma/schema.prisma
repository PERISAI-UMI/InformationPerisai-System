generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==========================================
// TABEL PSDM TERLINDUNGI (READ-ONLY OLEH WEBSITE)
// ==========================================

model User {
  id                String       @id
  prn               String?      @unique
  passwordHash      String       @map("password_hash")
  role              String
  generasi          Int
  departmentId      String       @map("department_id")
  jabatan           String
  namaLengkap       String       @map("nama_lengkap")
  tempatLahir       String?      @map("tempat_lahir")
  tanggalLahir      String?      @map("tanggal_lahir")
  alamat            String?
  noTelp            String?      @map("no_telp")
  email             String       @unique
  nim               String       @unique
  programStudiId    String       @map("program_studi_id")
  angkatan          Int
  linkedinUrl       String?      @map("linkedin_url")
  instagramUsername String?      @map("instagram_username")
  avatarUrl         String?      @map("avatar_url")

  department        Department   @relation(fields: [departmentId], references: [id])
  cmsAccess         UserAccess?

  @@map("users")
}

model Department {
  id          String              @id
  nama        String              @unique

  users       User[]
  profile     DepartmentProfile?
  programs    WorkProgram[]
  posts       Post[]
  members     Member[]

  @@map("departments")
}

model Fakultas {
  id          String         @id
  nama        String         @unique
  prodiList   ProgramStudi[]

  @@map("fakultas")
}

model ProgramStudi {
  id          String     @id
  fakultasId  String     @map("fakultas_id")
  nama        String

  fakultas    Fakultas   @relation(fields: [fakultasId], references: [id])

  @@map("program_studi")
}

// ==========================================
// TABEL WEBSITE KHUSUS (NAMA LOGIS -> @@map("web_*"))
// ==========================================

model Period {
  id          String     @id @default(uuid())
  name        String
  startDate   Int        @map("start_date")
  endDate     Int?       @map("end_date")
  isCurrent   Int        @default(0) @map("is_current")

  members     Member[]

  @@map("web_periods")
}

model Member {
  id           String      @id @default(uuid())
  periodId     String      @map("period_id")
  departmentId String?     @map("department_id")
  name         String
  position     String
  tier         String      @default("staf")
  linkedinUrl  String?     @map("linkedin_url")
  photoMediaId String?     @map("photo_media_id")
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Int         @default(1) @map("is_active")

  period       Period      @relation(fields: [periodId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@map("web_members")
}

model Media {
  id           String      @id @default(uuid())
  storageKey   String      @unique @map("storage_key")
  originalName String?     @map("original_name")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  width        Int?
  height       Int?
  altText      String?     @map("alt_text")
  uploadedBy   String?     @map("uploaded_by")
  createdAt    Int         @map("created_at")

  galleryItems GalleryItem[]
  postImages   PostImage[]
  programImages WorkProgramImage[]

  @@map("web_media")
}

model DepartmentProfile {
  departmentId       String      @id @map("department_id")
  slug               String      @unique
  shortDescription   String?     @map("short_description")
  description        String?
  vision             String?
  mission            String?
  groupPhotoMediaId  String?     @map("group_photo_media_id")
  sortOrder          Int         @default(0) @map("sort_order")
  isActive           Int         @default(1) @map("is_active")
  createdAt          Int         @map("created_at")
  updatedAt          Int         @map("updated_at")

  department         Department  @relation(fields: [departmentId], references: [id])

  @@map("web_department_profiles")
}

model UserAccess {
  userId        String      @id @map("user_id")
  cmsRole       String      @default("editor") @map("cms_role")
  departmentId  String?     @map("department_id")
  createdAt     Int         @map("created_at")
  updatedAt     Int         @map("updated_at")

  user          User        @relation(fields: [userId], references: [id])

  @@map("web_user_access")
}

model ExtraPerson {
  id           String      @id @default(uuid())
  name         String
  position     String
  tier         String      @default("pembina")
  linkedinUrl  String?     @map("linkedin_url")
  photoMediaId String?     @map("photo_media_id")
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Int         @default(1) @map("is_active")
  createdAt    Int         @map("created_at")
  updatedAt    Int         @map("updated_at")

  @@map("web_extra_people")
}

model Post {
  id           String          @id @default(uuid())
  departmentId String?         @map("department_id")
  title        String
  slug         String          @unique
  category     String          @default("berita")
  excerpt      String?
  content      String
  coverMediaId String?         @map("cover_media_id")
  status       String          @default("draft")
  publishedAt  Int?            @map("published_at")
  isFeatured   Int             @default(0) @map("is_featured")
  createdBy    String?         @map("created_by")
  updatedBy    String?         @map("updated_by")
  createdAt    Int             @map("created_at")
  updatedAt    Int             @map("updated_at")

  department   Department?     @relation(fields: [departmentId], references: [id])
  images       PostImage[]

  @@map("web_posts")
}

model PostImage {
  postId    String      @map("post_id")
  mediaId   String      @map("media_id")
  sortOrder Int         @default(0) @map("sort_order")
  caption   String?

  post      Post        @relation(fields: [postId], references: [id])
  media     Media       @relation(fields: [mediaId], references: [id])

  @@id([postId, mediaId])
  @@map("web_post_images")
}

model WorkProgram {
  id           String                 @id @default(uuid())
  departmentId String                 @map("department_id")
  title        String
  slug         String                 @unique
  summary      String?
  content      String?
  coverMediaId String?                @map("cover_media_id")
  status       String                 @default("draft")
  publishedAt  Int?                   @map("published_at")
  sortOrder    Int                    @default(0) @map("sort_order")
  createdBy    String?                @map("created_by")
  updatedBy    String?                @map("updated_by")
  createdAt    Int                    @map("created_at")
  updatedAt    Int                    @map("updated_at")

  department   Department             @relation(fields: [departmentId], references: [id])
  images       WorkProgramImage[]

  @@map("web_work_programs")
}

model WorkProgramImage {
  workProgramId String         @map("work_program_id")
  mediaId       String         @map("media_id")
  sortOrder     Int            @default(0) @map("sort_order")
  caption       String?

  workProgram   WorkProgram    @relation(fields: [workProgramId], references: [id])
  media         Media          @relation(fields: [mediaId], references: [id])

  @@id([workProgramId, mediaId])
  @@map("web_work_program_images")
}

model Opportunity {
  id              String      @id @default(uuid())
  type            String      @default("lomba")
  title           String
  slug            String      @unique
  category        String?
  organizer       String?
  description     String?
  deadlineAt      Int?        @map("deadline_at")
  registrationUrl String?     @map("registration_url")
  posterMediaId   String?     @map("poster_media_id")
  status          String      @default("draft")
  publishedAt     Int?        @map("published_at")
  createdBy       String?     @map("created_by")
  updatedBy       String?     @map("updated_by")
  createdAt       Int         @map("created_at")
  updatedAt       Int         @map("updated_at")

  @@map("web_opportunities")
}

model Statistic {
  id          String      @id @default(uuid())
  label       String
  value       String
  description String?
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Int         @default(1) @map("is_active")
  createdAt   Int         @map("created_at")
  updatedAt   Int         @map("updated_at")

  @@map("web_statistics")
}

model GalleryItem {
  id          String      @id @default(uuid())
  mediaId     String      @map("media_id")
  title       String
  description String?
  category    String?
  takenAt     Int?        @map("taken_at")
  isFeatured  Int         @default(0) @map("is_featured")
  isActive    Int         @default(1) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   Int         @map("created_at")
  updatedAt   Int         @map("updated_at")

  media       Media       @relation(fields: [mediaId], references: [id])

  @@map("web_gallery_items")
}

model InboxMessage {
  id          String      @id @default(uuid())
  name        String
  email       String
  phone       String?
  purpose     String      @default("pertanyaan")
  subject     String
  message     String
  isRead      Int         @default(0) @map("is_read")
  handledAt   Int?        @map("handled_at")
  handledBy   String?     @map("handled_by")
  ipHash      String?     @map("ip_hash")
  createdAt   Int         @map("created_at")

  @@map("web_inbox_messages")
}

model Setting {
  key         String      @id
  value       String?
  updatedBy   String?     @map("updated_by")
  updatedAt   Int         @map("updated_at")

  @@map("web_site_settings")
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      String?     @map("user_id")
  action      String
  entityType  String?     @map("entity_type")
  entityId    String?     @map("entity_id")
  changes     String?
  ipHash      String?     @map("ip_hash")
  createdAt   Int         @map("created_at")

  @@map("web_audit_logs")
}


// ========================================================
// STRUKTUR DATA BARU 2026/2027 (M_* & T_*)
// ========================================================

model MFakultas {
  idFakultas   Int        @id @default(autoincrement()) @map("id_fakultas")
  namaFakultas String     @unique @map("nama_fakultas")
  kodeFakultas String?    @unique @map("kode_fakultas")
  createdAt    Int        @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt    Int        @default(dbgenerated("(unixepoch())")) @map("updated_at")

  jurusan      MJurusan[]

  @@map("M_Fakultas")
}

model MJurusan {
  idJurusan   Int        @id @default(autoincrement()) @map("id_jurusan")
  idFakultas  Int        @map("id_fakultas")
  namaJurusan String     @map("nama_jurusan")
  jenjang     String     @default("S1")
  createdAt   Int        @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt   Int        @default(dbgenerated("(unixepoch())")) @map("updated_at")

  fakultas    MFakultas  @relation(fields: [idFakultas], references: [idFakultas], onDelete: Cascade)
  anggota     MAnggota[]

  @@map("M_Jurusan")
}

model MDepartemen {
  idDepartemen     Int             @id @default(autoincrement()) @map("id_departemen")
  namaDepartemen   String          @unique @map("nama_departemen")
  singkatan        String          @unique
  slug             String          @unique
  tupoksiUtama     String?         @map("tupoksi_utama")
  deskripsiSingkat String?         @map("deskripsi_singkat")
  visi             String?
  misi             String?
  fotoGrup         String?         @map("foto_grup")
  urutan           Int             @default(0)
  isActive         Int             @default(1) @map("is_active")
  createdAt        Int             @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt        Int             @default(dbgenerated("(unixepoch())")) @map("updated_at")

  jabatan          MJabatan[]
  kepengurusan     TKepengurusan[]
  proker           TProker[]
  berita           TBerita[]
  kompetisi        TKompetisi[]

  @@map("M_Departemen")
}

model MJabatan {
  idJabatan     Int             @id @default(autoincrement()) @map("id_jabatan")
  idDepartemen  Int?            @map("id_departemen")
  namaJabatan   String          @map("nama_jabatan")
  levelHirarki  Int             @default(5) @map("level_hirarki")
  urutan        Int             @default(0)
  createdAt     Int             @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt     Int             @default(dbgenerated("(unixepoch())")) @map("updated_at")

  departemen    MDepartemen?    @relation(fields: [idDepartemen], references: [idDepartemen], onDelete: SetNull)
  kepengurusan  TKepengurusan[]

  @@map("M_Jabatan")
}

model MPeriode {
  idPeriode        Int             @id @default(autoincrement()) @map("id_periode")
  namaPeriode      String          @unique @map("nama_periode")
  tahunMulai       Int             @map("tahun_mulai")
  tahunSelesai     Int             @map("tahun_selesai")
  isActive         Int             @default(0) @map("is_active")
  temaKepengurusan String?         @map("tema_kepengurusan")
  visi             String?
  misi             String?
  createdAt        Int             @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt        Int             @default(dbgenerated("(unixepoch())")) @map("updated_at")

  kepengurusan     TKepengurusan[]
  proker           TProker[]
  keuangan         TKeuangan[]

  @@map("M_Periode")
}

model MRole {
  idRole    Int      @id @default(autoincrement()) @map("id_role")
  namaRole  String   @unique @map("nama_role")
  label     String
  deskripsi String?
  createdAt Int      @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt Int      @default(dbgenerated("(unixepoch())")) @map("updated_at")

  akun      MAkun[]

  @@map("M_Role")
}

model MAnggota {
  idPerisai    String          @id @map("id_perisai")
  namaLengkap  String          @map("nama_lengkap")
  nim          String          @unique
  idJurusan    Int?            @map("id_jurusan")
  angkatan     Int
  gen          Int
  tempatLahir  String?         @map("tempat_lahir")
  tanggalLahir String?         @map("tanggal_lahir")
  jenisKelamin String?         @default("L") @map("jenis_kelamin")
  email        String          @unique
  noWa         String?         @map("no_wa")
  alamat       String?
  linkedin     String?
  instagram    String?
  hobi         String?
  quotes       String?
  fotoUrl      String?         @map("foto_url")
  status       String          @default("aktif")
  createdAt    Int             @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt    Int             @default(dbgenerated("(unixepoch())")) @map("updated_at")

  jurusan      MJurusan?       @relation(fields: [idJurusan], references: [idJurusan], onDelete: SetNull)
  akun         MAkun?
  kepengurusan TKepengurusan[]
  prestasi     TPrestasi[]
  prokerPj     TProker[]       @relation("ProkerPenanggungJawab")
  beritaDitulis TBerita[]      @relation("BeritaPenulis")
  keuanganDicatat TKeuangan[]  @relation("KeuanganDicatatOleh")

  @@map("M_Anggota")
}

model MAkun {
  idAkun       Int        @id @default(autoincrement()) @map("id_akun")
  idPerisai    String     @unique @map("id_perisai")
  idRole       Int        @map("id_role")
  passwordHash String     @map("password_hash")
  isActive     Int        @default(1) @map("is_active")
  lastLogin    Int?       @map("last_login")
  createdAt    Int        @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt    Int        @default(dbgenerated("(unixepoch())")) @map("updated_at")

  anggota      MAnggota   @relation(fields: [idPerisai], references: [idPerisai], onDelete: Cascade)
  role         MRole      @relation(fields: [idRole], references: [idRole], onDelete: Restrict)
  sesi         TSesi[]

  @@map("M_Akun")
}

model TSesi {
  idSesi    String   @id @map("id_sesi")
  idAkun    Int      @map("id_akun")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  payload   String?
  expiresAt Int      @map("expires_at")
  createdAt Int      @default(dbgenerated("(unixepoch())")) @map("created_at")

  akun      MAkun    @relation(fields: [idAkun], references: [idAkun], onDelete: Cascade)

  @@map("T_Sesi")
}

model MPembina {
  idPembina   Int      @id @default(autoincrement()) @map("id_pembina")
  nama        String
  gelar       String?
  jabatan     String
  kategori    String   @default("pembina")
  fotoUrl     String?  @map("foto_url")
  linkedin    String?
  urutan      Int      @default(0)
  isActive    Int      @default(1) @map("is_active")
  createdAt   Int      @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt   Int      @default(dbgenerated("(unixepoch())")) @map("updated_at")

  @@map("M_Pembina")
}

model TKepengurusan {
  idKepengurusan Int          @id @default(autoincrement()) @map("id_kepengurusan")
  idPeriode      Int          @map("id_periode")
  idPerisai      String       @map("id_perisai")
  idJabatan      Int          @map("id_jabatan")
  idDepartemen   Int?         @map("id_departemen")
  tier           String       @default("staf")
  status         String       @default("aktif")
  urutan         Int          @default(0)
  createdAt      Int          @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt      Int          @default(dbgenerated("(unixepoch())")) @map("updated_at")

  periode        MPeriode     @relation(fields: [idPeriode], references: [idPeriode], onDelete: Cascade)
  anggota        MAnggota     @relation(fields: [idPerisai], references: [idPerisai], onDelete: Cascade)
  jabatan        MJabatan     @relation(fields: [idJabatan], references: [idJabatan], onDelete: Restrict)
  departemen     MDepartemen? @relation(fields: [idDepartemen], references: [idDepartemen], onDelete: SetNull)

  @@unique([idPeriode, idPerisai, idJabatan])
  @@map("T_Kepengurusan")
}

model TProker {
  idProker              Int                  @id @default(autoincrement()) @map("id_proker")
  idDepartemen          Int                  @map("id_departemen")
  idPeriode             Int                  @map("id_periode")
  namaProker            String               @map("nama_proker")
  slug                  String               @unique
  deskripsi             String?
  targetPelaksanaan     String?              @map("target_pelaksanaan")
  indikatorKeberhasilan String?              @map("indikator_keberhasilan")
  penanggungJawabId     String?              @map("penanggung_jawab_id")
  fotoCover             String?              @map("foto_cover")
  status                String               @default("rencana")
  urutan                Int                  @default(0)
  diperbaruiOleh        String?              @map("diperbarui_oleh")
  createdAt             Int                  @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt             Int                  @default(dbgenerated("(unixepoch())")) @map("updated_at")

  departemen            MDepartemen          @relation(fields: [idDepartemen], references: [idDepartemen], onDelete: Cascade)
  periode               MPeriode             @relation(fields: [idPeriode], references: [idPeriode], onDelete: Cascade)
  penanggungJawab       MAnggota?            @relation("ProkerPenanggungJawab", fields: [penanggungJawabId], references: [idPerisai], onDelete: SetNull)
  dokumentasi           TProkerDokumentasi[]

  @@map("T_Proker")
}

model TProkerDokumentasi {
  idProkerDok Int      @id @default(autoincrement()) @map("id_proker_dok")
  idProker    Int      @map("id_proker")
  fotoUrl     String   @map("foto_url")
  caption     String?
  urutan      Int      @default(0)
  createdAt   Int      @default(dbgenerated("(unixepoch())")) @map("created_at")

  proker      TProker  @relation(fields: [idProker], references: [idProker], onDelete: Cascade)

  @@map("T_Proker_Dokumentasi")
}

model TBerita {
  idBerita       Int           @id @default(autoincrement()) @map("id_berita")
  idDepartemen   Int?          @map("id_departemen")
  judul          String
  slug           String        @unique
  kategori       String        @default("berita")
  ringkasan      String?
  konten         String
  fotoCover      String?       @map("foto_cover")
  penulisId      String?       @map("penulis_id")
  status         String        @default("draft")
  tanggalPublish Int?          @map("tanggal_publish")
  isFeatured     Int           @default(0) @map("is_featured")
  views          Int           @default(0)
  diperbaruiOleh String?       @map("diperbarui_oleh")
  createdAt      Int           @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt      Int           @default(dbgenerated("(unixepoch())")) @map("updated_at")

  departemen     MDepartemen?  @relation(fields: [idDepartemen], references: [idDepartemen], onDelete: SetNull)
  penulis        MAnggota?     @relation("BeritaPenulis", fields: [penulisId], references: [idPerisai], onDelete: SetNull)
  foto           TBeritaFoto[]

  @@map("T_Berita")
}

model TBeritaFoto {
  idBeritaFoto Int      @id @default(autoincrement()) @map("id_berita_foto")
  idBerita     Int      @map("id_berita")
  fotoUrl      String   @map("foto_url")
  caption      String?
  urutan       Int      @default(0)
  createdAt    Int      @default(dbgenerated("(unixepoch())")) @map("created_at")

  berita       TBerita  @relation(fields: [idBerita], references: [idBerita], onDelete: Cascade)

  @@map("T_Berita_Foto")
}

model TKompetisi {
  idKompetisi         Int          @id @default(autoincrement()) @map("id_kompetisi")
  idDepartemen        Int?         @map("id_departemen")
  tipe                String       @default("lomba")
  namaKompetisi       String       @map("nama_kompetisi")
  slug                String       @unique
  kategori            String       @default("KTI")
  tingkat             String       @default("Nasional")
  penyelenggara       String
  deskripsi           String?
  deadlinePendaftaran Int?         @map("deadline_pendaftaran")
  tanggalPelaksanaan  String?      @map("tanggal_pelaksanaan")
  linkPendaftaran     String?      @map("link_pendaftaran")
  linkPanduan         String?      @map("link_panduan")
  linkPoster          String?      @map("link_poster")
  status              String       @default("published")
  tanggalPublish      Int?         @map("tanggal_publish")
  views               Int          @default(0)
  penulisId           String?      @map("penulis_id")
  diperbaruiOleh      String?      @map("diperbarui_oleh")
  createdAt           Int          @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt           Int          @default(dbgenerated("(unixepoch())")) @map("updated_at")

  departemen          MDepartemen? @relation(fields: [idDepartemen], references: [idDepartemen], onDelete: SetNull)

  @@map("T_Kompetisi")
}

model TPrestasi {
  idPrestasi      Int       @id @default(autoincrement()) @map("id_prestasi")
  idPerisai       String    @map("id_perisai")
  namaKompetisi   String    @map("nama_kompetisi")
  judulKarya      String?   @map("judul_karya")
  kategori        String?
  tingkat         String    @default("Nasional")
  peringkat       String
  tahun           Int
  penyelenggara   String?
  anggotaTim      String?   @map("anggota_tim")
  fotoDokumentasi String?   @map("foto_dokumentasi")
  linkSertifikat  String?   @map("link_sertifikat")
  createdAt       Int       @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt       Int       @default(dbgenerated("(unixepoch())")) @map("updated_at")

